# Copy this file to ".env" and fill in your real values (never commit .env)

# Server port
PORT=4000

# MongoDB connection string (MongoDB Atlas)
MongoURI=your_mongodb_atlas_connection_string

# Cloudinary credentials (Dashboard → Account Details)
CLOUD_NAME=your_cloudinary_cloud_name
API_KEY=your_cloudinary_api_key
API_SECRET=your_cloudinary_api_secret

# Auth — long random string used to sign JWTs
JWT_SECRET=your_long_random_secret

# Admin login (only used by `npm run seed:admin` to create the admin account)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_admin_password
